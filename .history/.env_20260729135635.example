# --- Kanji Express environment variables ---
# Copy to .env.local for local `vercel dev`, and set the same keys in the
# Vercel dashboard (Project Settings → Environment Variables) for deploys.

# MongoDB Atlas connection string (include the db user + password).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database name to use inside the cluster.
MONGODB_DB="kanji_express"

# Secret used to sign JWTs. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# --- Optional: natural server-side TTS (Google Cloud Text-to-Speech) ---
# Leave both unset to use the free, built-in browser voice (Web Speech API).
# To enable natural ja-JP voices: create a Google Cloud API key with the
# Text-to-Speech API enabled, set it here, and add VITE_TTS_MODE=server.
# GOOGLE_TTS_API_KEY="your-google-cloud-api-key"
VITE_TTS_MODE="server"
